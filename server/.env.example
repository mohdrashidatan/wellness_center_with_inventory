PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=
JWT_EXP_TIME=1h

FRONTEND_URL=http://localhost:5173

# Gmail account used to send transactional emails (receipts, password resets).
# Use a Google App Password, not the account's login password.
EMAIL_USER=
EMAIL_PASS=

# Minutes a password reset link stays valid
RESET_PASSWORD_TOKEN_EXP_MIN=30

# --- Pilot guard ------------------------------------------------------------
# Public /api/auth/signup creates Therapist accounts. Set true to block it.
DISABLE_PUBLIC_SIGNUP=false

# --- Login with Singpass (FAPI 2.0) -----------------------------------------
# Off unless "true". See docs/singpass-pilot/README.md.
SINGPASS_ENABLED=false
# Staging: https://stg-id.singpass.gov.sg/fapi  Production: https://id.singpass.gov.sg/fapi
SINGPASS_ISSUER_URL=https://stg-id.singpass.gov.sg/fapi
# 32-character client ID from the Singpass Developer Portal
SINGPASS_CLIENT_ID=
# Must exactly match a redirect URL registered in the portal
SINGPASS_REDIRECT_URI=http://localhost:5000/api/auth/singpass/callback
# Where the browser lands after Singpass (defaults to the first FRONTEND_URL)
SINGPASS_FRONTEND_URL=http://localhost:5173
# Private JWKS generated by scripts/singpass-generate-keys.js (path relative to server/)
SINGPASS_PRIVATE_JWKS_FILE=secrets/singpass/private-jwks.json
SINGPASS_SCOPES=openid
SINGPASS_ALLOWED_ROLES=Therapist,Admin
# Login apps: APP_AUTHENTICATION_DEFAULT (default). Myinfo apps reject it: set "none".
# SINGPASS_AUTH_CONTEXT_TYPE=
# Optional override. Default: LoA 1-3 in staging, LoA 2-3 in production.
# SINGPASS_ACCEPTED_ACR=
# Never set in production; the server refuses to start if it is.
# SINGPASS_ALLOW_LOCAL_MOCK_ISSUER=false
